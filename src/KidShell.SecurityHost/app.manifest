<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <assemblyIdentity version="1.0.0.0" name="KidShell.SecurityHost" />

  <!--
    asInvoker, with the elevation requirement enforced in code instead.

    The obvious choice here is requireAdministrator, and it was the first one.
    It has a practical problem: a binary that cannot start unelevated cannot run
    its own self-test on a build agent, so the check that proves the helper
    parses and rejects hostile input would be the one check nobody could run.

    The security property is unchanged. KidShell launches this helper with the
    "runas" verb, which raises the UAC prompt regardless of what the manifest
    says, and Program.cs refuses to enter the request loop unless the process is
    genuinely elevated - so an unelevated helper does nothing except exit. The
    enforcement moved from a declaration to a runtime check that has a test.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

</assembly>
