<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The elevated helper.

    A console executable, not a service: it starts when a parent confirms a
    security change, does the typed work it was asked for, and exits. There is
    no resident elevated process, no listening endpoint and no persistent
    privilege - which is the point. A long-lived administrator service that
    accepts requests is a much larger thing to get right than a short-lived
    process that reads one conversation from its own stdin.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>KidShell.SecurityHost</RootNamespace>
    <AssemblyName>KidShell.SecurityHost</AssemblyName>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- requireAdministrator: the helper must not run silently unelevated. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KidShell.Core\KidShell.Core.csproj" />
    <ProjectReference Include="..\KidShell.WindowsIntegration\KidShell.WindowsIntegration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KidShell.WindowsIntegration.Tests" />
  </ItemGroup>

</Project>
