<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The recovery tool.

    A recovery administrator runs this when KidShell itself cannot start. It
    reads the typed recovery manifests KidShell wrote before it changed
    anything, explains what happened in plain Swedish, and can undo it.

    It deliberately does not depend on KidShell's configuration, its window, or
    anything in the child's profile - the situation it exists for is the one
    where those are unavailable.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>KidShell.Recovery</RootNamespace>
    <AssemblyName>KidShell.Recovery</AssemblyName>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KidShell.Core\KidShell.Core.csproj" />
    <ProjectReference Include="..\KidShell.WindowsIntegration\KidShell.WindowsIntegration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KidShell.WindowsIntegration.Tests" />
  </ItemGroup>

</Project>
