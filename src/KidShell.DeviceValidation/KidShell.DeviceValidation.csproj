<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The dedicated-device validation tool.

    WHY THIS EXISTS AS A PROGRAM AND NOT AS POWERSHELL.

    The validation scripts have to gather facts from a real Windows machine,
    which is PowerShell's job. Deciding whether those facts are acceptable is a
    different job, and it is the one worth testing: whether the interlock
    refuses, whether an access list matches the plan, whether a stage may be
    called a pass.

    Writing those rules twice, once in C# for the tests and once in PowerShell
    for the actual run, would be exactly the defect this repository keeps
    finding: a correct component, and a production path that does not reach it.
    So the rules live in KidShell.Core, this exposes them to the scripts, and
    the scripts own no judgement of their own.

    IT CHANGES NOTHING. There is no code here that writes to the registry,
    touches the service control manager, creates an account or edits an access
    list. It reads JSON that a script gathered, applies rules, and prints a
    verdict.

    (A pair of hyphens is not legal inside an XML comment, so the headings
    above are written as sentences. The same mistake in an application
    manifest produced a binary Windows refused to start, and reported it as a
    side-by-side configuration error that mentioned nothing about manifests.)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>KidShell.DeviceValidation</RootNamespace>
    <AssemblyName>KidShell.DeviceValidation</AssemblyName>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KidShell.Core\KidShell.Core.csproj" />
  </ItemGroup>

</Project>
