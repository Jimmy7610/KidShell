<UserControl
    x:Class="KidShell.App.Views.SceneBackground"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsHitTestVisible="False"
    IsTabStop="False"
    AutomationProperties.AccessibilityView="Raw">

    <!--
        The illustrated KidShell world.

        Entirely vector: gradients, hills, a lake, trees and clouds drawn as
        XAML shapes on a 1920x520 canvas that is stretched to whatever panel
        the app is running on. Decorative only - it is hit-test invisible and
        hidden from assistive technology.
    -->
    <Grid x:Name="SceneRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="54*" />
            <RowDefinition Height="46*" />
        </Grid.RowDefinitions>

        <!-- ===== Sky ===== -->
        <Rectangle x:Name="SkyMeadow" Grid.RowSpan="2">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.15,1">
                    <GradientStop Offset="0" Color="#FFA9D8F4" />
                    <GradientStop Offset="0.55" Color="#FFCFE9FA" />
                    <GradientStop Offset="1" Color="#FFEDF7FD" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle x:Name="SkySunset" Grid.RowSpan="2" Opacity="0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.15,1">
                    <GradientStop Offset="0" Color="#FFF6C1A0" />
                    <GradientStop Offset="0.5" Color="#FFFBDFC6" />
                    <GradientStop Offset="1" Color="#FFFDF2E6" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle x:Name="SkyOcean" Grid.RowSpan="2" Opacity="0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.15,1">
                    <GradientStop Offset="0" Color="#FF87C6E8" />
                    <GradientStop Offset="0.55" Color="#FFB9E2F2" />
                    <GradientStop Offset="1" Color="#FFE6F6FB" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ===== Clouds ===== -->
        <Viewbox Grid.Row="0" Stretch="Fill">
            <Canvas Width="1920" Height="560">
                <Ellipse Canvas.Left="150" Canvas.Top="242" Width="190" Height="76" Fill="#D9FFFFFF" />
                <Ellipse Canvas.Left="216" Canvas.Top="214" Width="150" Height="94" Fill="#D9FFFFFF" />
                <Ellipse Canvas.Left="296" Canvas.Top="246" Width="146" Height="70" Fill="#D9FFFFFF" />

                <Ellipse Canvas.Left="790" Canvas.Top="186" Width="210" Height="76" Fill="#C6FFFFFF" />
                <Ellipse Canvas.Left="860" Canvas.Top="158" Width="156" Height="92" Fill="#C6FFFFFF" />
                <Ellipse Canvas.Left="950" Canvas.Top="188" Width="152" Height="70" Fill="#C6FFFFFF" />

                <Ellipse Canvas.Left="1380" Canvas.Top="320" Width="170" Height="60" Fill="#99FFFFFF" />
                <Ellipse Canvas.Left="1436" Canvas.Top="298" Width="124" Height="74" Fill="#99FFFFFF" />

                <Ellipse Canvas.Left="470" Canvas.Top="376" Width="150" Height="50" Fill="#73FFFFFF" />
                <Ellipse Canvas.Left="518" Canvas.Top="360" Width="110" Height="58" Fill="#73FFFFFF" />
            </Canvas>
        </Viewbox>

        <!-- ===== Sun (fixed proportions so it never turns into an oval) ===== -->
        <Grid
            Grid.Row="0"
            Width="152" Height="152"
            Margin="0,54,28,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <Ellipse Fill="{StaticResource SunGlowBrush}" Margin="10" />
            <Ellipse Margin="32" Fill="{StaticResource SunCoreBrush}" />
            <Path
                Stroke="#FFF6C63A" StrokeThickness="7"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M 76,6 L 76,20 M 76,132 L 76,146 M 6,76 L 20,76 M 132,76 L 146,76 M 27,27 L 37,37 M 115,115 L 125,125 M 125,27 L 115,37 M 37,115 L 27,125" />
        </Grid>

        <!-- ===== Landscape ===== -->
        <Viewbox Grid.Row="1" Stretch="Fill" VerticalAlignment="Bottom">
            <Canvas Width="1920" Height="520">
                <!-- Distant mountains -->
                <Path Fill="{StaticResource MountainBrush}"
                      Data="M 900,160 L 1080,10 L 1196,124 L 1276,44 L 1450,160 Z" />
                <Path Fill="{StaticResource MountainSnowBrush}"
                      Data="M 1056,48 L 1080,26 L 1106,48 L 1088,56 L 1072,42 Z" />
                <Path Fill="{StaticResource MountainSnowBrush}"
                      Data="M 1250,70 L 1268,52 L 1290,74 L 1276,80 L 1262,66 Z" />

                <!-- Far hills -->
                <Path Fill="{StaticResource HillFarBrush}"
                      Data="M 0,128 C 200,64 380,156 560,116 C 760,70 900,146 1100,104 C 1320,58 1520,146 1720,116 C 1820,100 1880,116 1920,104 L 1920,520 L 0,520 Z" />

                <!-- Mid hills -->
                <Path Fill="{StaticResource HillMidBrush}"
                      Data="M 0,208 C 220,146 420,238 640,196 C 860,154 1060,242 1300,200 C 1520,162 1740,222 1920,190 L 1920,520 L 0,520 Z" />

                <!-- Lake -->
                <Ellipse Canvas.Left="560" Canvas.Top="248" Width="820" Height="176" Fill="{StaticResource LakeBrush}" />
                <Ellipse Canvas.Left="700" Canvas.Top="286" Width="240" Height="34" Fill="#66FFFFFF" />
                <Ellipse Canvas.Left="1010" Canvas.Top="320" Width="150" Height="22" Fill="#4DFFFFFF" />

                <!-- Near hills, wrapping the lake -->
                <Path Fill="{StaticResource HillNearBrush}"
                      Data="M 0,338 C 260,286 460,366 700,352 C 786,346 846,398 960,398 C 1074,398 1134,346 1220,352 C 1460,366 1680,290 1920,338 L 1920,520 L 0,520 Z" />

                <!-- Trees, left cluster -->
                <Rectangle Canvas.Left="128" Canvas.Top="244" Width="20" Height="70" Fill="{StaticResource TrunkBrush}" />
                <Ellipse Canvas.Left="86" Canvas.Top="186" Width="104" Height="92" Fill="{StaticResource TreeDarkBrush}" />
                <Ellipse Canvas.Left="106" Canvas.Top="164" Width="86" Height="80" Fill="{StaticResource TreeLightBrush}" />
                <Rectangle Canvas.Left="236" Canvas.Top="268" Width="15" Height="54" Fill="{StaticResource TrunkBrush}" />
                <Ellipse Canvas.Left="204" Canvas.Top="222" Width="80" Height="70" Fill="{StaticResource TreeDarkBrush}" />

                <!-- Trees, right cluster -->
                <Rectangle Canvas.Left="1706" Canvas.Top="240" Width="22" Height="74" Fill="{StaticResource TrunkBrush}" />
                <Ellipse Canvas.Left="1660" Canvas.Top="178" Width="114" Height="98" Fill="{StaticResource TreeDarkBrush}" />
                <Ellipse Canvas.Left="1684" Canvas.Top="156" Width="90" Height="84" Fill="{StaticResource TreeLightBrush}" />
                <Rectangle Canvas.Left="1590" Canvas.Top="272" Width="14" Height="50" Fill="{StaticResource TrunkBrush}" />
                <Ellipse Canvas.Left="1560" Canvas.Top="228" Width="76" Height="66" Fill="{StaticResource TreeDarkBrush}" />

                <!-- Bushes -->
                <Ellipse Canvas.Left="300" Canvas.Top="378" Width="70" Height="44" Fill="{StaticResource TreeDarkBrush}" />
                <Ellipse Canvas.Left="332" Canvas.Top="386" Width="56" Height="36" Fill="{StaticResource TreeLightBrush}" />
                <Ellipse Canvas.Left="1420" Canvas.Top="384" Width="62" Height="40" Fill="{StaticResource TreeDarkBrush}" />
                <Ellipse Canvas.Left="1394" Canvas.Top="392" Width="50" Height="32" Fill="{StaticResource TreeLightBrush}" />

                <!-- Flowers -->
                <Ellipse Canvas.Left="470" Canvas.Top="406" Width="13" Height="13" Fill="#FFFFFFFF" />
                <Ellipse Canvas.Left="520" Canvas.Top="422" Width="11" Height="11" Fill="#FFFDE9A9" />
                <Ellipse Canvas.Left="1470" Canvas.Top="404" Width="13" Height="13" Fill="#FFFFFFFF" />
                <Ellipse Canvas.Left="1530" Canvas.Top="424" Width="11" Height="11" Fill="#FFFDE9A9" />
                <Ellipse Canvas.Left="180" Canvas.Top="420" Width="12" Height="12" Fill="#FFFFFFFF" />

                <!-- Foreground wave the footer sits on -->
                <Path Fill="#E6FFFFFF"
                      Data="M 0,438 C 300,396 620,478 960,446 C 1300,414 1640,476 1920,436 L 1920,520 L 0,520 Z" />
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
