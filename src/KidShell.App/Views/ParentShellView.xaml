<UserControl
    x:Class="KidShell.App.Views.ParentShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KidShell.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:KidShell.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:parent="using:KidShell.App.Views.Parent"
    xmlns:views="using:KidShell.App.Views"
    x:Name="RootControl"
    mc:Ignorable="d">

    <Grid x:Name="Stage" Padding="{StaticResource StagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            ============================= Header =============================

            The columns are set from code: across while the three blocks fit,
            down a single column when they do not. See AdaptiveHeader.
        -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" ColumnSpacing="24" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <StackPanel x:Name="HeaderBrand" Grid.Column="0" VerticalAlignment="Top">
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource WordmarkTextStyle}"
                        TextWrapping="Wrap"
                        Text="{loc:Str Key=Parent.Title}" />
                    <Canvas
                        Grid.Column="1"
                        Width="46" Height="34"
                        Margin="0,-6,-40,0"
                        VerticalAlignment="Top">
                        <Path
                            Stroke="{StaticResource BrandSparkBrush}" StrokeThickness="5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Data="M 10,26 L 6,6 M 24,20 L 28,2 M 36,28 L 44,14" />
                    </Canvas>
                </Grid>
                <TextBlock
                    x:Name="HeaderTagline"
                    Margin="4,2,0,0"
                    Style="{StaticResource TaglineTextStyle}"
                    Text="{loc:Str Key=Parent.Subtitle}" />
            </StackPanel>

            <!--
                Centred between the wordmark and the status strip, and allowed
                to shrink: at 800 epx the avatar used to overlap the wordmark,
                which truncated "Föräldraläge" to "Föräldra".
            -->
            <StackPanel
                x:Name="HeaderChild"
                Grid.Column="1"
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16"
                VerticalAlignment="Top">
                <Border
                    Width="76" Height="76"
                    Background="{StaticResource PanelStrongBrush}"
                    BorderBrush="{StaticResource BrandBlueLightBrush}"
                    BorderThickness="4"
                    CornerRadius="{StaticResource RadiusPill}">
                    <Border CornerRadius="{StaticResource RadiusPill}">
                        <Viewbox>
                            <controls:AvatarPresenter x:Name="Avatar" Width="100" Height="100" />
                        </Viewbox>
                    </Border>
                </Border>
                <StackPanel x:Name="HeaderChildText" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="ChildSummaryText"
                        TextTrimming="CharacterEllipsis"
                        FontFamily="{StaticResource DisplayFontFamily}"
                        FontSize="23"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource OnSceneStrongBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            Foreground="{StaticResource OnSceneSecondaryBrush}"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{loc:Str Key=Parent.ChildMotto}" />
                        <FontIcon
                            FontFamily="{StaticResource SymbolFontFamily}"
                            FontSize="13"
                            Foreground="#FFE0574F"
                            Glyph="&#xEB52;"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <views:StatusStrip
                x:Name="Status"
                Grid.Column="2"
                Margin="0,12,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top" />
        </Grid>

        <!-- ============================= Body ============================= -->
        <!--
            Three columns, two of which give way.

            The aside was a fixed 352 and the sidebar a fixed 218, which at
            1024 effective pixels left roughly 400 for the content - narrower
            than a single settings row needs. Both widths now come from
            ResponsiveLayout, which is tested against the whole supported
            matrix rather than against the monitor this was written on.
        -->
        <Grid x:Name="BodyGrid" Grid.Row="1" Margin="0,20,0,14" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition x:Name="AsideColumn" Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ========== Sidebar ========== -->
            <Border
                x:Name="NavigationPanel"
                Grid.Column="0"
                Width="218"
                Style="{StaticResource PanelStyle}"
                Padding="12"
                Translation="0,0,22">
                <!--
                    The rail scrolls if it has to.

                    Six items at their full height need more than a 480-epx
                    window leaves for them, and a Border with a corner radius
                    clips what it contains - so the last item was laid out,
                    never drawn, and could not be reached by pointer or by
                    keyboard. There was nothing on screen to suggest it existed.
                -->
                <ScrollViewer
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    ZoomMode="Disabled">
                    <StackPanel AutomationProperties.Name="{loc:Str Key=Nav.Automation}">
                        <RadioButton
                            x:Name="NavOverview"
                            Checked="OnNavChecked"
                            GroupName="ParentNav"
                            Style="{StaticResource NavigationItemStyle}"
                            AutomationProperties.Name="{loc:Str Key=Nav.Overview}"
                            ToolTipService.ToolTip="{loc:Str Key=Nav.Overview}"
                            Tag="Overview">
                            <!-- A Grid, so the label learns how wide its column is and wraps. -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE80F;" Style="{StaticResource NavigationGlyphStyle}" Grid.Column="0" />
                                <TextBlock Grid.Column="1" x:Name="NavLabelOverview" Text="{loc:Str Key=Nav.Overview}" VerticalAlignment="Center"  TextWrapping="Wrap" />
                            </Grid>
                        </RadioButton>

                        <RadioButton
                            x:Name="NavApps"
                            Checked="OnNavChecked"
                            GroupName="ParentNav"
                            Style="{StaticResource NavigationItemStyle}"
                            AutomationProperties.Name="{loc:Str Key=Nav.Apps}"
                            ToolTipService.ToolTip="{loc:Str Key=Nav.Apps}"
                            Tag="Apps">
                            <!-- A Grid, so the label learns how wide its column is and wraps. -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A9;" Style="{StaticResource NavigationGlyphStyle}" Grid.Column="0" />
                                <TextBlock Grid.Column="1" x:Name="NavLabelApps" Text="{loc:Str Key=Nav.Apps}" VerticalAlignment="Center"  TextWrapping="Wrap" />
                            </Grid>
                        </RadioButton>

                        <RadioButton
                            x:Name="NavScreenTime"
                            Checked="OnNavChecked"
                            GroupName="ParentNav"
                            Style="{StaticResource NavigationItemStyle}"
                            AutomationProperties.Name="{loc:Str Key=Nav.ScreenTime}"
                            ToolTipService.ToolTip="{loc:Str Key=Nav.ScreenTime}"
                            Tag="ScreenTime">
                            <!-- A Grid, so the label learns how wide its column is and wraps. -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE823;" Style="{StaticResource NavigationGlyphStyle}" Grid.Column="0" />
                                <TextBlock Grid.Column="1" x:Name="NavLabelScreenTime" Text="{loc:Str Key=Nav.ScreenTime}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </RadioButton>

                        <RadioButton
                            x:Name="NavWeb"
                            Checked="OnNavChecked"
                            GroupName="ParentNav"
                            Style="{StaticResource NavigationItemStyle}"
                            AutomationProperties.Name="{loc:Str Key=Nav.Web}"
                            ToolTipService.ToolTip="{loc:Str Key=Nav.Web}"
                            Tag="Web">
                            <!-- A Grid, so the label learns how wide its column is and wraps. -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE774;" Style="{StaticResource NavigationGlyphStyle}" Grid.Column="0" />
                                <TextBlock Grid.Column="1" x:Name="NavLabelWeb" Text="{loc:Str Key=Nav.Web}" VerticalAlignment="Center"  TextWrapping="Wrap" />
                            </Grid>
                        </RadioButton>

                        <RadioButton
                            x:Name="NavSecurity"
                            Checked="OnNavChecked"
                            GroupName="ParentNav"
                            Style="{StaticResource NavigationItemStyle}"
                            AutomationProperties.Name="{loc:Str Key=Nav.Security}"
                            ToolTipService.ToolTip="{loc:Str Key=Nav.Security}"
                            Tag="Security">
                            <!-- A Grid, so the label learns how wide its column is and wraps. -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA18;" Style="{StaticResource NavigationGlyphStyle}" Grid.Column="0" />
                                <TextBlock Grid.Column="1" x:Name="NavLabelSecurity" Text="{loc:Str Key=Nav.Security}" VerticalAlignment="Center"  TextWrapping="Wrap" />
                            </Grid>
                        </RadioButton>

                        <RadioButton
                            x:Name="NavProfile"
                            Checked="OnNavChecked"
                            GroupName="ParentNav"
                            Style="{StaticResource NavigationItemStyle}"
                            AutomationProperties.Name="{loc:Str Key=Nav.Profile}"
                            ToolTipService.ToolTip="{loc:Str Key=Nav.Profile}"
                            Tag="Profile">
                            <!-- A Grid, so the label learns how wide its column is and wraps. -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE77B;" Style="{StaticResource NavigationGlyphStyle}" Grid.Column="0" />
                                <TextBlock Grid.Column="1" x:Name="NavLabelProfile" Text="{loc:Str Key=Nav.Profile}" VerticalAlignment="Center"  TextWrapping="Wrap" />
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========== Page host ========== -->
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="0" Translation="0,0,22">
                <Grid>
                    <parent:ParentOverviewPage x:Name="PageOverview" />
                    <parent:ParentAppsPage x:Name="PageApps" Visibility="Collapsed" />
                    <parent:ParentScreenTimePage x:Name="PageScreenTime" Visibility="Collapsed" />
                    <parent:ParentWebPage x:Name="PageWeb" Visibility="Collapsed" />
                    <parent:ParentSecurityPage x:Name="PageSecurity" Visibility="Collapsed" />
                    <parent:ParentProfilePage x:Name="PageProfile" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- ========== At-a-glance column ========== -->
            <ScrollViewer
                x:Name="Aside"
                Grid.Column="2"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">

                    <Border Background="{StaticResource TintGreenBrush}" Style="{StaticResource InfoPanelStyle}">
                        <StackPanel Spacing="10">
                            <!--
                                A Grid, so everything inside learns how much
                                width the card has. A horizontal StackPanel
                                measures its children against infinity, which
                                is why the status text below was cut off by the
                                card however carefully it was told to wrap.
                            -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#FFD7F0E0" Style="{StaticResource PanelBadgeStyle}">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolFontFamily}"
                                        FontSize="22"
                                        Foreground="{StaticResource StatusOkBrush}"
                                        Glyph="&#xE72E;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{loc:Str Key=Security.ParentPin}" />
                                    <!--
                                        A Grid, not a horizontal StackPanel.
                                        The status text has to know how wide
                                        its column is, or it is measured
                                        against unlimited width and cut off by
                                        the card instead of wrapping - at 200%
                                        this read "Aktiv (standard".
                                    -->
                                    <Grid ColumnSpacing="7" Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            Foreground="{StaticResource StatusOkBrush}"
                                            Glyph="&#xE73E;"
                                            Style="{StaticResource StatusGlyphStyle}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            x:Name="PinStatusText"
                                            Style="{StaticResource StatusChipTextStyle}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Krävs för att ändra inställningar." />
                            <Button
                                x:Name="ChangePinButton"
                                Content="{loc:Str Key=Security.ChangePin}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SoftButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource TintAmberBrush}" Style="{StaticResource InfoPanelStyle}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid ColumnSpacing="14" Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#FFFCEBC4" Style="{StaticResource PanelBadgeStyle}" Grid.Column="0">
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolFontFamily}"
                                            FontSize="22"
                                            Foreground="{StaticResource StatusWarningBrush}"
                                            Glyph="&#xE823;" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource SectionTitleTextStyle}"
                                        Text="{loc:Str Key=ScreenTime.Title}"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <Button
                                    Grid.Column="1"
                                    x:Name="GoToScreenTimeButton"
                                    Click="OnGoToScreenTime"
                                    Content="Ändra"
                                    Style="{StaticResource SoftButtonStyle}"
                                    VerticalAlignment="Top" />
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{loc:Str Key=ScreenTime.Weekdays}" Grid.Column="0" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="AsideWeekdayText"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource BodyTextStyle}" />
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{loc:Str Key=ScreenTime.Weekends}" Grid.Column="0" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="AsideWeekendText"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource BodyTextStyle}" />
                            </Grid>
                            <TextBlock
                                x:Name="AsideScreenTimeNotice"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{loc:Str Key=Overview.ScreenTimeHint}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource TintBlueBrush}" Style="{StaticResource InfoPanelStyle}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid ColumnSpacing="14" Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#FFD9EAFB" Style="{StaticResource PanelBadgeStyle}" Grid.Column="0">
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolFontFamily}"
                                            FontSize="22"
                                            Foreground="{StaticResource BrandBlueBrush}"
                                            Glyph="&#xE774;" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource SectionTitleTextStyle}"
                                        Text="{loc:Str Key=Web.Title}"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <Button
                                    Grid.Column="1"
                                    x:Name="GoToWebButton"
                                    Click="OnGoToWeb"
                                    Content="Ändra"
                                    Style="{StaticResource SoftButtonStyle}"
                                    VerticalAlignment="Top" />
                            </Grid>
                            <!-- Same reason as the PIN status above. -->
                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    x:Name="AsideWebGlyph"
                                    Foreground="{StaticResource BrandBlueBrush}"
                                    Glyph="&#xE73E;"
                                    Style="{StaticResource StatusGlyphStyle}" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="AsideWebText"
                                    Style="{StaticResource StatusChipTextStyle}"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{loc:Str Key=Overview.WebHint}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================= Footer ============================= -->
        <!--
            Two columns, and the actions take what they need first.

            These used to share one cell, the brand aligned left and the
            buttons right, which works only while they do not meet. Enlarged
            text makes them meet: at 150% the tagline ran 168 epx underneath
            the Tillbaka button, and the buttons themselves ran off the left
            edge of the window.

            Now the buttons get their width and the brand gets what is left -
            and gives way entirely when that is not enough, because it is
            decoration and they are the way out of Föräldraläge.
        -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                The ACTIONS take the starred column, not the brand.

                A WrapPanel in an Auto column is never told how much width it
                has - Auto measures with infinity - so it laid everything on
                one row and ran off the edge however wide the buttons got.
                Starred, it is handed a real limit and wraps inside it, which
                is the entire reason it is a WrapPanel.

                The brand is Auto because it is decoration that disappears
                when it does not fit; FitFooterBrand decides that by
                measurement before this column is ever used.
            -->

            <StackPanel
                x:Name="FooterBrand"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <Border
                    Width="26" Height="26"
                    Background="{StaticResource BrandBlueLightBrush}"
                    CornerRadius="{StaticResource RadiusSm}">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Rectangle Grid.Row="0" Grid.Column="0" Margin="0,0,1,1" Fill="White" />
                        <Rectangle Grid.Row="0" Grid.Column="1" Margin="1,0,0,1" Fill="White" />
                        <Rectangle Grid.Row="1" Grid.Column="0" Margin="0,1,1,0" Fill="White" />
                        <Rectangle Grid.Row="1" Grid.Column="1" Margin="1,1,0,0" Fill="White" />
                    </Grid>
                </Border>
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{loc:Str Key=Child.FooterTagline}"
                    VerticalAlignment="Center" />

                <Border
                    x:Name="UnsavedBadge"
                    Margin="12,0,0,0"
                    Background="{StaticResource TintAmberBrush}"
                    Style="{StaticResource StatusChipStyle}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            Foreground="{StaticResource StatusWarningBrush}"
                            Glyph="&#xE7BA;"
                            Style="{StaticResource StatusGlyphStyle}" />
                        <TextBlock
                            Foreground="{StaticResource StatusWarningBrush}"
                            Style="{StaticResource StatusChipTextStyle}"
                            Text="{loc:Str Key=Parent.UnsavedBadge}" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="SavedBadge"
                    Margin="12,0,0,0"
                    Background="{StaticResource TintGreenBrush}"
                    Style="{StaticResource StatusChipStyle}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            Foreground="{StaticResource StatusOkBrush}"
                            Glyph="&#xE73E;"
                            Style="{StaticResource StatusGlyphStyle}" />
                        <TextBlock
                            x:Name="StatusMessageText"
                            Foreground="{StaticResource StatusOkBrush}"
                            Style="{StaticResource StatusChipTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--
                A WrapPanel, not a StackPanel.

                Three buttons in a row is fine until the words in them grow.
                At 150% text they were wider than the window, and the first one
                - the way back to Barnläge - was the one pushed off the edge.
                Wrapping puts them on two lines instead, which is longer and
                reachable rather than short and not.
            -->
            <controls:WrapPanel
                x:Name="FooterActions"
                Grid.Column="1"
                HorizontalAlignment="Right"
                HorizontalSpacing="12"
                VerticalSpacing="10"
                VerticalAlignment="Center">
                <Button
                    x:Name="BackButton"
                    Style="{StaticResource SecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon
                            FontFamily="{StaticResource SymbolFontFamily}"
                            FontSize="15"
                            Glyph="&#xE72B;" />
                        <TextBlock Text="{loc:Str Key=Parent.BackToChild}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ExitButton"
                    Content="{loc:Str Key=Parent.ExitToWindows}"
                    Style="{StaticResource SecondaryButtonStyle}" />
                <Button
                    x:Name="SaveButton"
                    Content="{loc:Str Key=Parent.Save}"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </controls:WrapPanel>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1320" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Aside.Visibility" Value="Collapsed" />
                        <Setter Target="AsideColumn.Width" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
