<UserControl
    x:Class="KidShell.App.Views.StatusStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KidShell.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:KidShell.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Clock, network and battery. Read-only system state; KidShell changes
        nothing about either. Every readout has a text or glyph fallback so
        that a machine without a battery simply shows less, never an error.
    -->
    <!--
        A WrapPanel, so the readouts drop to a second line rather than off the
        edge. At a larger text size the clock and the battery are simply wider,
        and a horizontal StackPanel has no way to say so.
    -->
    <controls:WrapPanel
        x:Name="Strip"
        HorizontalSpacing="16"
        VerticalSpacing="4"
        VerticalAlignment="Center">

        <FontIcon
            x:Name="NetworkGlyph"
            FontFamily="{StaticResource SymbolFontFamily}"
            FontSize="20"
            Foreground="{StaticResource OnSceneStrongBrush}"
            Glyph="&#xE701;"
            VerticalAlignment="Center" />

        <!--
            Wrapping, because the strip can be narrower than the readout.

            At 640 epx with 200% text the clock needed 88 and was given 82, so
            the last digit was simply not drawn - and a clock missing a digit
            is worse than a clock on two lines.
        -->
        <TextBlock
            x:Name="ClockText"
            TextWrapping="Wrap"
            Style="{StaticResource StatusStripTextStyle}" />

        <!--
            The glyph and the figure are two wrap items, not one row.

            Kept together they are a single block the WrapPanel cannot split,
            and on a narrow strip at a large text size the figure was simply
            cut off the right-hand edge. Apart, the percentage drops to the
            next line and stays readable. BatteryPanel remains as the element
            the code shows and hides, and as the one carrying the accessible
            name for both.
        -->
        <StackPanel
            x:Name="BatteryPanel"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">
            <FontIcon
                x:Name="BatteryGlyph"
                FontFamily="{StaticResource SymbolFontFamily}"
                FontSize="20"
                Foreground="{StaticResource OnSceneStrongBrush}"
                Glyph="&#xE83F;"
                VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock
            x:Name="BatteryText"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Style="{StaticResource StatusStripTextStyle}" />

    </controls:WrapPanel>
</UserControl>
