<UserControl
    x:Class="KidShell.App.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KidShell.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:KidShell.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KidShell.App.ViewModels"
    mc:Ignorable="d">

    <!--
        First-run setup.

        Six screens in one card, swapped by visibility with a short enter
        transition. Everything the parent picks stays on the view model until
        the final screen is confirmed.
    -->
    <UserControl.Resources>
        <Storyboard x:Name="StepEnter">
            <DoubleAnimation
                Storyboard.TargetName="StepTranslate"
                Storyboard.TargetProperty="X"
                From="26" To="0"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="StepHost"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                Duration="0:0:0.18" />
        </Storyboard>

        <Storyboard x:Name="StepEnterBack">
            <DoubleAnimation
                Storyboard.TargetName="StepTranslate"
                Storyboard.TargetProperty="X"
                From="-26" To="0"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="StepHost"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                Duration="0:0:0.18" />
        </Storyboard>
    </UserControl.Resources>

    <Grid Padding="40,28,40,28">
        <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <Border
                x:Name="SetupPanel"
                MaxWidth="960"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource SetupPanelStyle}"
                Translation="0,0,48">

                <Grid x:Name="StepHost" RowSpacing="22">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="StepTranslate" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ===== Step indicator ===== -->
                    <TextBlock
                        x:Name="StepIndicatorText"
                        Grid.Row="0"
                        Style="{StaticResource SetupStepTextStyle}" />

                    <!-- ===================== 1. Welcome ===================== -->
                    <StackPanel x:Name="StepWelcome" Grid.Row="1" Spacing="18">
                        <Grid HorizontalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource WordmarkTextStyle}"
                                Text="{loc:Str Key=Child.Wordmark}" />
                            <Canvas
                                Width="46" Height="34"
                                Margin="0,-6,-40,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                                <Path
                                    Stroke="{StaticResource BrandSparkBrush}" StrokeThickness="5"
                                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                    Data="M 10,26 L 6,6 M 24,20 L 28,2 M 36,28 L 44,14" />
                            </Canvas>
                        </Grid>

                        <TextBlock
                            Style="{StaticResource SetupHeadlineTextStyle}"
                            Text="{loc:Str Key=Setup.WelcomeTitle}" />
                        <TextBlock
                            Style="{StaticResource SetupBodyTextStyle}"
                            Text="{loc:Str Key=Setup.WelcomeBody}" />
                        <TextBlock
                            MaxWidth="460"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{loc:Str Key=Setup.WelcomeHint}"
                            TextAlignment="Center" />
                    </StackPanel>

                    <!-- ===================== 2. Name ===================== -->
                    <StackPanel x:Name="StepName" Grid.Row="1" Spacing="16" Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource SetupHeadlineTextStyle}"
                            Text="{loc:Str Key=Setup.NameTitle}" />
                        <TextBlock
                            Style="{StaticResource SetupBodyTextStyle}"
                            Text="{loc:Str Key=Setup.NameBody}" />
                        <TextBox
                            x:Name="NameBox"
                            MaxWidth="440"
                            Margin="0,8,0,0"
                            AutomationProperties.Name="{loc:Str Key=Setup.NameLabel}"
                            MaxLength="32"
                            PlaceholderText="{loc:Str Key=Setup.NamePlaceholder}"
                            Style="{StaticResource SetupNameTextBoxStyle}"
                            TextChanged="OnNameChanged" />
                    </StackPanel>

                    <!-- ===================== 3. Avatar ===================== -->
                    <StackPanel x:Name="StepAvatar" Grid.Row="1" Spacing="14" Visibility="Collapsed">
                        <TextBlock
                            x:Name="AvatarTitleText"
                            Style="{StaticResource SetupHeadlineTextStyle}" />
                        <TextBlock
                            x:Name="AvatarBodyText"
                            Style="{StaticResource SetupBodyTextStyle}" />

                        <ItemsRepeater
                            x:Name="AvatarGrid"
                            MaxWidth="820"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="14"
                                    MinItemHeight="110"
                                    MinItemWidth="96"
                                    MinRowSpacing="14" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:OnboardingAvatarViewModel">
                                    <Button
                                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                        Click="OnAvatarClick"
                                        Style="{StaticResource SetupTileStyle}"
                                        Tag="{x:Bind}">
                                        <Grid>
                                            <Border Style="{StaticResource SetupTileSurfaceStyle}" />
                                            <Border
                                                Style="{StaticResource SetupTileSelectedSurfaceStyle}"
                                                Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            <Viewbox Margin="14">
                                                <controls:AvatarPresenter AvatarId="{x:Bind Id}" Width="100" Height="100" />
                                            </Viewbox>
                                            <Border
                                                Width="28" Height="28"
                                                Margin="0,0,6,6"
                                                Background="{StaticResource BrandBlueBrush}"
                                                CornerRadius="{StaticResource RadiusPill}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <FontIcon
                                                    FontFamily="{StaticResource SymbolFontFamily}"
                                                    FontSize="13"
                                                    Foreground="White"
                                                    Glyph="&#xE73E;" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- ===================== 4. Age ===================== -->
                    <StackPanel x:Name="StepAge" Grid.Row="1" Spacing="14" Visibility="Collapsed">
                        <TextBlock
                            x:Name="AgeTitleText"
                            Style="{StaticResource SetupHeadlineTextStyle}" />
                        <TextBlock
                            Style="{StaticResource SetupBodyTextStyle}"
                            Text="{loc:Str Key=Setup.AgeBody}" />

                        <ItemsRepeater
                            x:Name="AgeGrid"
                            MaxWidth="712"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="14"
                                    MinItemHeight="104"
                                    MinItemWidth="104"
                                    MinRowSpacing="14" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:OnboardingAgeViewModel">
                                    <Button
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        Click="OnAgeClick"
                                        Style="{StaticResource SetupTileStyle}"
                                        Tag="{x:Bind}">
                                        <Grid>
                                            <Border Style="{StaticResource SetupTileSurfaceStyle}" />
                                            <Border
                                                Style="{StaticResource SetupTileSelectedSurfaceStyle}"
                                                Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock
                                                Style="{StaticResource SetupAgeTextStyle}"
                                                Text="{x:Bind Label}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- ===================== 5. Theme ===================== -->
                    <StackPanel x:Name="StepTheme" Grid.Row="1" Spacing="14" Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource SetupHeadlineTextStyle}"
                            Text="{loc:Str Key=Setup.ThemeTitle}" />
                        <TextBlock
                            x:Name="ThemeBodyText"
                            Style="{StaticResource SetupBodyTextStyle}" />

                        <ItemsRepeater
                            x:Name="ThemeGrid"
                            MaxWidth="872"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="14"
                                    MinItemHeight="198"
                                    MinItemWidth="160"
                                    MinRowSpacing="14" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:OnboardingThemeViewModel">
                                    <Button
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        Click="OnThemeClick"
                                        Style="{StaticResource SetupTileStyle}"
                                        Tag="{x:Bind}">
                                        <Grid>
                                            <Border Style="{StaticResource SetupTileSurfaceStyle}" />
                                            <Border
                                                Style="{StaticResource SetupTileSelectedSurfaceStyle}"
                                                Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                                            <StackPanel Margin="12" Spacing="10">
                                                <Grid Height="92">
                                                    <Border
                                                        Background="{x:Bind Swatch}"
                                                        CornerRadius="{StaticResource RadiusMd}" />
                                                    <Border
                                                        Width="28" Height="28"
                                                        Margin="0,7,7,0"
                                                        Background="{StaticResource BrandBlueBrush}"
                                                        BorderBrush="White"
                                                        BorderThickness="2"
                                                        CornerRadius="{StaticResource RadiusPill}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                        <FontIcon
                                                            FontFamily="{StaticResource SymbolFontFamily}"
                                                            FontSize="12"
                                                            Foreground="White"
                                                            Glyph="&#xE73E;" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock
                                                    Style="{StaticResource SetupTileLabelTextStyle}"
                                                    Text="{x:Bind Label}" />
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    Text="{x:Bind Hint}"
                                                    TextAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- ===================== 6. Finish ===================== -->
                    <StackPanel x:Name="StepDone" Grid.Row="1" Spacing="14" Visibility="Collapsed">
                        <Border
                            Width="148" Height="148"
                            HorizontalAlignment="Center"
                            Background="{StaticResource PanelStrongBrush}"
                            BorderBrush="{StaticResource BrandBlueLightBrush}"
                            BorderThickness="6"
                            CornerRadius="{StaticResource RadiusPill}">
                            <Viewbox Margin="6">
                                <controls:AvatarPresenter x:Name="DoneAvatar" Width="100" Height="100" />
                            </Viewbox>
                        </Border>

                        <TextBlock
                            x:Name="DoneTitleText"
                            Style="{StaticResource SetupHeadlineTextStyle}" />
                        <TextBlock
                            Style="{StaticResource SetupBodyTextStyle}"
                            Text="{loc:Str Key=Setup.DoneBody}" />

                        <Border
                            HorizontalAlignment="Center"
                            Background="{StaticResource TintBlueBrush}"
                            Style="{StaticResource StatusChipStyle}">
                            <TextBlock
                                x:Name="DoneSummaryText"
                                Foreground="{StaticResource BrandBlueBrush}"
                                Style="{StaticResource StatusChipTextStyle}" />
                        </Border>
                    </StackPanel>

                    <!-- ===== Validation ===== -->
                    <StackPanel
                        x:Name="ValidationPanel"
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="9"
                        Visibility="Collapsed">
                        <FontIcon
                            FontFamily="{StaticResource SymbolFontFamily}"
                            FontSize="16"
                            Foreground="{StaticResource StatusAlertBrush}"
                            Glyph="&#xEA39;"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="ValidationText"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource StatusAlertBrush}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- ===== Navigation ===== -->
                    <StackPanel
                        Grid.Row="3"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0"
                        Orientation="Horizontal"
                        Spacing="14">
                        <Button
                            x:Name="BackButton"
                            Content="{loc:Str Key=Setup.Back}"
                            Style="{StaticResource SetupSecondaryButtonStyle}" />
                        <Button
                            x:Name="PrimaryButton"
                            Style="{StaticResource SetupPrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
