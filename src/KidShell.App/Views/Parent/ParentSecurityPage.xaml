<UserControl
    x:Class="KidShell.App.Views.Parent.ParentSecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:KidShell.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KidShell.App.ViewModels.Parent"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="26,24,26,24" Spacing="20">

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{loc:Str Key=Security.Title}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{loc:Str Key=Security.Subtitle}" />
            </StackPanel>

            <!-- Status list. Each row carries a glyph and a word, never colour alone. -->
            <Border Background="{StaticResource TintNeutralBrush}" CornerRadius="{StaticResource RadiusLg}" Padding="8,4">
                <ItemsRepeater x:Name="StatusList">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="0" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SecurityStatusViewModel">
                            <Border AutomationProperties.Name="{x:Bind AutomationName}" Style="{StaticResource ListRowStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Grid.Column="0"
                                        FontFamily="{StaticResource SymbolFontFamily}"
                                        FontSize="17"
                                        Foreground="{x:Bind StatusBrush}"
                                        Glyph="{x:Bind Glyph}"
                                        VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{StaticResource BodyTextStyle}"
                                            Text="{x:Bind Label}" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{x:Bind Hint}"
                                            Visibility="{x:Bind Hint, Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>

                                    <Border Grid.Column="2" Style="{StaticResource StatusChipStyle}">
                                        <TextBlock Style="{StaticResource StatusChipTextStyle}" Text="{x:Bind Value}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>

            <Border Background="{StaticResource TintRoseBrush}" Style="{StaticResource InfoPanelStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        FontFamily="{StaticResource SymbolFontFamily}"
                        FontSize="22"
                        Foreground="{StaticResource StatusAlertBrush}"
                        Glyph="&#xEA18;"
                        VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{loc:Str Key=Security.BannerTitle}" />
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{loc:Str Key=Security.BannerBody}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Where the data lives; nothing leaves the machine. -->
            <Border Background="{StaticResource TintBlueBrush}" Style="{StaticResource InfoPanelStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{loc:Str Key=Security.LocalOnly}" />
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="{loc:Str Key=Security.ConfigPathTitle}" />
                        <TextBlock
                            x:Name="ConfigPathText"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="{loc:Str Key=Security.LogPathTitle}" />
                        <TextBlock
                            x:Name="LogPathText"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
