<UserControl
    x:Class="KidShell.App.Views.Parent.ParentSecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:KidShell.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KidShell.App.ViewModels.Parent"
    mc:Ignorable="d">

    <!--
        Föräldraläge → Säkerhet.

        A readiness dashboard. Everything here is read from the machine and
        nothing on this page can change a Windows setting: the two buttons open
        informational dialogs and "Kör kontroll igen" repeats the same
        read-only detection.
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="26,24,26,24" Spacing="18">

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{loc:Str Key=Security.Title}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{loc:Str Key=Security.Subtitle}" />
            </StackPanel>

            <!-- ===================== Säkerhetsstatus ===================== -->
            <Border Background="{StaticResource TintAmberBrush}" Style="{StaticResource InfoPanelStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        FontFamily="{StaticResource SymbolFontFamily}"
                        FontSize="26"
                        Foreground="{StaticResource StatusWarningBrush}"
                        Glyph="&#xE7BA;"
                        VerticalAlignment="Top" />

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{loc:Str Key=Security.StatusTitle}" />
                        <TextBlock
                            x:Name="StatusHeadlineText"
                            FontFamily="{StaticResource DisplayFontFamily}"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock
                            x:Name="LockNoticeText"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource StatusWarningBrush}"
                            Style="{StaticResource BodyTextStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="StatusBodyText"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        x:Name="RescanButton"
                        Grid.Column="2"
                        Content="{loc:Str Key=Security.Rescan}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!-- ===================== Behöver åtgärdas ===================== -->
            <Border
                x:Name="BlockerPanel"
                Background="{StaticResource TintRoseBrush}"
                Style="{StaticResource InfoPanelStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon
                            FontFamily="{StaticResource SymbolFontFamily}"
                            FontSize="17"
                            Foreground="{StaticResource StatusAlertBrush}"
                            Glyph="&#xEA39;"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="{loc:Str Key=Security.BlockersTitle}" />
                    </StackPanel>
                    <ItemsRepeater x:Name="BlockerList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{x:Bind}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- ===================== Att känna till ===================== -->
            <Border
                x:Name="WarningPanel"
                Background="{StaticResource TintNeutralBrush}"
                Style="{StaticResource InfoPanelStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon
                            FontFamily="{StaticResource SymbolFontFamily}"
                            FontSize="17"
                            Foreground="{StaticResource StatusWarningBrush}"
                            Glyph="&#xE7BA;"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="{loc:Str Key=Security.WarningsTitle}" />
                    </StackPanel>
                    <ItemsRepeater x:Name="WarningList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- ===================== Windows-information ===================== -->
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{loc:Str Key=Security.WindowsInfoTitle}" />

                <Border Background="{StaticResource TintBlueBrush}" CornerRadius="{StaticResource RadiusLg}" Padding="18,14">
                    <ItemsRepeater x:Name="WindowsFactList">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="18"
                                MinItemHeight="52"
                                MinItemWidth="190"
                                MinRowSpacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SecurityFactViewModel">
                                <StackPanel AutomationProperties.Name="{x:Bind AutomationName}" Spacing="2">
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind Label}" />
                                    <TextBlock
                                        FontFamily="{StaticResource DisplayFontFamily}"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="{x:Bind Value}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
            </StackPanel>

            <!-- ===================== Rekommenderat säkerhetsläge ===================== -->
            <Border Background="{StaticResource TintGreenBrush}" Style="{StaticResource InfoPanelStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{loc:Str Key=Security.RecommendedTitle}" />
                        <TextBlock
                            x:Name="RecommendedModeText"
                            FontFamily="{StaticResource DisplayFontFamily}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock
                            x:Name="RecommendedModeBodyText"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <Button
                            x:Name="CompareButton"
                            Content="{loc:Str Key=Security.ShowDifference}"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource SecondaryButtonStyle}" />
                        <Button
                            x:Name="PlanButton"
                            Content="{loc:Str Key=Security.ShowPlan}"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Funktioner ===================== -->
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{loc:Str Key=Security.CapabilitiesTitle}" />

                <Border Background="{StaticResource TintNeutralBrush}" CornerRadius="{StaticResource RadiusLg}" Padding="8,4">
                    <ItemsRepeater x:Name="CapabilityList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SecurityStatusViewModel">
                                <Border AutomationProperties.Name="{x:Bind AutomationName}" Style="{StaticResource ListRowStyle}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            FontFamily="{StaticResource SymbolFontFamily}"
                                            FontSize="17"
                                            Foreground="{x:Bind StatusBrush}"
                                            Glyph="{x:Bind Glyph}"
                                            VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Style="{StaticResource BodyTextStyle}"
                                                Text="{x:Bind Label}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{x:Bind Hint}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind Hint, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Style="{StaticResource StatusChipStyle}" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource StatusChipTextStyle}" Text="{x:Bind Value}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
            </StackPanel>

            <!-- ===================== Kontroller ===================== -->
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{loc:Str Key=Security.ChecksTitle}" />

                <Border Background="{StaticResource TintNeutralBrush}" CornerRadius="{StaticResource RadiusLg}" Padding="8,4">
                    <ItemsRepeater x:Name="CheckList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SecurityCheckViewModel">
                                <Border AutomationProperties.Name="{x:Bind AutomationName}" Style="{StaticResource ListRowStyle}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            FontFamily="{StaticResource SymbolFontFamily}"
                                            FontSize="17"
                                            Foreground="{x:Bind StatusBrush}"
                                            Glyph="{x:Bind Glyph}"
                                            VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Style="{StaticResource BodyTextStyle}"
                                                Text="{x:Bind Title}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{x:Bind Detail}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Style="{StaticResource StatusChipStyle}" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource StatusChipTextStyle}" Text="{x:Bind StatusLabel}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
            </StackPanel>

            <!-- ===================== Avancerat ===================== -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="{loc:Str Key=Security.Advanced}">
                <StackPanel Padding="0,10,0,4" Spacing="14">

                    <ItemsRepeater x:Name="DiagnosticsList">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="18"
                                MinItemHeight="48"
                                MinItemWidth="200"
                                MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SecurityFactViewModel">
                                <StackPanel AutomationProperties.Name="{x:Bind AutomationName}" Spacing="1">
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind Label}" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource BodyTextStyle}"
                                        Text="{x:Bind Value}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Border Background="{StaticResource TintBlueBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="14,10">
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{loc:Str Key=Security.AuditOnlyNote}"
                            TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="{loc:Str Key=Security.ConfigPathTitle}" />
                        <TextBlock
                            x:Name="ConfigPathText"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="{loc:Str Key=Security.LogPathTitle}" />
                        <TextBlock
                            x:Name="LogPathText"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- ===================== Prototype-stage status ===================== -->
            <StackPanel Spacing="10">
                <Border Background="{StaticResource TintNeutralBrush}" CornerRadius="{StaticResource RadiusLg}" Padding="8,4">
                    <ItemsRepeater x:Name="StatusList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SecurityStatusViewModel">
                                <Border AutomationProperties.Name="{x:Bind AutomationName}" Style="{StaticResource ListRowStyle}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            FontFamily="{StaticResource SymbolFontFamily}"
                                            FontSize="17"
                                            Foreground="{x:Bind StatusBrush}"
                                            Glyph="{x:Bind Glyph}"
                                            VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Style="{StaticResource BodyTextStyle}"
                                                Text="{x:Bind Label}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{x:Bind Hint}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind Hint, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Style="{StaticResource StatusChipStyle}" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource StatusChipTextStyle}" Text="{x:Bind Value}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
            </StackPanel>


            <!--
                Återställning.

                Almost always this says "nothing has been changed", and that is
                the whole content. The case it exists for is the rare one: a
                change failed AND its rollback failed, so the machine is in a
                state nobody chose. That must be impossible to miss.
            -->
            <Border x:Name="RecoveryPanel" Background="{StaticResource TintNeutralBrush}" Style="{StaticResource InfoPanelStyle}">
                <StackPanel Spacing="12">

                    <Grid>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{loc:Str Key=Recovery.Title}" />
                            <TextBlock
                                x:Name="RecoveryHeadline"
                                FontWeight="SemiBold"
                                Style="{StaticResource BodyTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="RecoveryRefreshButton"
                            Content="{loc:Str Key=Recovery.Refresh}"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButtonStyle}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        x:Name="RecoveryExplanation"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />

                    <ItemsRepeater x:Name="RecoveryList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecoveryEntryViewModel">
                                <Border
                                    Background="{StaticResource PanelBrush}"
                                    CornerRadius="10"
                                    Padding="12,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Style="{StaticResource BodyTextStyle}"
                                                Text="{x:Bind When}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{x:Bind Summary}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource StatusChipTextStyle}" Text="{x:Bind State}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Where the files are, so a parent can find them without KidShell. -->
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="{loc:Str Key=Recovery.LocationTitle}" />
                        <TextBlock
                            x:Name="RecoveryLocation"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{loc:Str Key=Recovery.ToolHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
