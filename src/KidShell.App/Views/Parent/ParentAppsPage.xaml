<UserControl
    x:Class="KidShell.App.Views.Parent.ParentAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KidShell.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:KidShell.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KidShell.App.ViewModels.Parent"
    mc:Ignorable="d">

    <Grid Padding="26,24,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{loc:Str Key=Apps.Title}" />
                <TextBlock
                    x:Name="SubtitleText"
                    Margin="0,4,0,0"
                    Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>

            <Button
                x:Name="AddAppButton"
                HorizontalAlignment="Right"
                Style="{StaticResource PrimaryButtonStyle}"
                VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontFamily="{StaticResource SymbolFontFamily}"
                        FontSize="14"
                        Glyph="&#xE710;" />
                    <TextBlock Text="{loc:Str Key=Apps.Add}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Rows -->
        <Border Grid.Row="1" Background="{StaticResource TintNeutralBrush}" CornerRadius="{StaticResource RadiusLg}" Padding="8,4">
            <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="AppRows">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="0" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ParentAppRowViewModel">
                            <Border Style="{StaticResource ListRowStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="42" Height="42"
                                        Background="{x:Bind AccentBrush}"
                                        CornerRadius="{StaticResource RadiusSm}">
                                        <Viewbox Margin="6">
                                            <controls:AppIconPresenter
                                                Width="100" Height="100"
                                                IconKey="{x:Bind IconKey}" />
                                        </Viewbox>
                                    </Border>

                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource BodyTextStyle}"
                                        Text="{x:Bind ProgramName}"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="{x:Bind Description}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="3"
                                        MinWidth="74"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="{x:Bind EnabledText, Mode=OneWay}"
                                        TextAlignment="Right"
                                        VerticalAlignment="Center" />

                                    <ToggleSwitch
                                        Grid.Column="4"
                                        AutomationProperties.Name="{x:Bind ToggleAutomationName}"
                                        IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                        Style="{StaticResource AppToggleStyle}" />

                                    <Button
                                        Grid.Column="5"
                                        AutomationProperties.Name="{x:Bind RemoveAutomationName}"
                                        Click="OnRemoveClick"
                                        Padding="10,6"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{loc:Str Key=Apps.Remove}">
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolFontFamily}"
                                            FontSize="15"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
