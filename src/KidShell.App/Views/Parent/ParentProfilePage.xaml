<UserControl
    x:Class="KidShell.App.Views.Parent.ParentProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KidShell.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:KidShell.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KidShell.App.ViewModels.Parent"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="26,24,26,24" Spacing="20">

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{loc:Str Key=Profile.Title}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{loc:Str Key=Profile.Subtitle}" />
            </StackPanel>

            <!--
                The form and its live preview sit side by side while both are
                readable, and stack below that. Code-behind moves the preview
                between column 1 and row 1; see ApplyLayout.
            -->
            <Grid x:Name="ProfileGrid" ColumnSpacing="18" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Spacing="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="{loc:Str Key=Profile.NameLabel}" />
                        <TextBox
                            x:Name="NameBox"
                            AutomationProperties.Name="{loc:Str Key=Profile.NameLabel}"
                            MaxLength="24"
                            Style="{StaticResource FormTextBoxStyle}"
                            TextChanged="OnNameChanged" />
                    </StackPanel>

                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="{loc:Str Key=Profile.AgeLabel}" />
                            <TextBlock
                                x:Name="AgeValueText"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrandBlueBrush}"
                                HorizontalAlignment="Right"
                                Style="{StaticResource BodyTextStyle}" />
                        </Grid>
                        <Slider
                            x:Name="AgeSlider"
                            AutomationProperties.Name="{loc:Str Key=Profile.AgeLabel}"
                            Maximum="18"
                            Minimum="2"
                            StepFrequency="1"
                            TickFrequency="1"
                            TickPlacement="Outside"
                            ValueChanged="OnAgeChanged" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="{loc:Str Key=Profile.ThemeLabel}" />
                        <ComboBox
                            x:Name="ThemeBox"
                            AutomationProperties.Name="{loc:Str Key=Profile.ThemeLabel}"
                            CornerRadius="{StaticResource RadiusMd}"
                            DisplayMemberPath="Label"
                            HorizontalAlignment="Stretch"
                            MinHeight="42"
                            SelectionChanged="OnThemeChanged" />
                    </StackPanel>
                </StackPanel>

                <!-- Live preview of what the child will see -->
                <Border
                    x:Name="PreviewPanel"
                    Grid.Column="1"
                    MinWidth="248"
                    MaxWidth="360"
                    Background="{StaticResource TintBlueBrush}"
                    Style="{StaticResource InfoPanelStyle}"
                    VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource FormLabelStyle}"
                            Text="{loc:Str Key=Profile.PreviewTitle}" />
                        <Border
                            Width="96" Height="96"
                            Background="{StaticResource PanelStrongBrush}"
                            BorderBrush="{StaticResource BrandBlueLightBrush}"
                            BorderThickness="4"
                            CornerRadius="{StaticResource RadiusPill}"
                            HorizontalAlignment="Center">
                            <Viewbox>
                                <controls:AvatarPresenter x:Name="PreviewAvatar" Width="100" Height="100" />
                            </Viewbox>
                        </Border>
                        <TextBlock
                            x:Name="PreviewGreetingText"
                            FontFamily="{StaticResource DisplayFontFamily}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            x:Name="PreviewSummaryText"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource FormLabelStyle}" Text="{loc:Str Key=Profile.AvatarLabel}" />
                <ItemsRepeater x:Name="AvatarList">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinColumnSpacing="14" MinItemHeight="104" MinItemWidth="104" MinRowSpacing="14" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:AvatarChoiceViewModel">
                            <Button
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                Background="Transparent"
                                Click="OnAvatarClick"
                                CornerRadius="{StaticResource RadiusPill}"
                                Padding="0"
                                Style="{StaticResource QuietButtonStyle}"
                                Tag="{x:Bind}">
                                <Border
                                    Width="92" Height="92"
                                    Background="{StaticResource PanelStrongBrush}"
                                    BorderBrush="{StaticResource BrandBlueLightBrush}"
                                    BorderThickness="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SelectionThickness}}"
                                    CornerRadius="{StaticResource RadiusPill}">
                                    <Grid>
                                        <Viewbox Margin="4">
                                            <controls:AvatarPresenter AvatarId="{x:Bind Id}" Width="100" Height="100" />
                                        </Viewbox>
                                        <!-- Selection is shown by a badge as well as the ring. -->
                                        <Border
                                            Width="26" Height="26"
                                            Background="{StaticResource BrandBlueBrush}"
                                            CornerRadius="{StaticResource RadiusPill}"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,2,2"
                                            VerticalAlignment="Bottom"
                                            Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <FontIcon
                                                FontFamily="{StaticResource SymbolFontFamily}"
                                                FontSize="12"
                                                Foreground="White"
                                                Glyph="&#xE73E;" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!--
                Development- and handover-friendly: clears only the child
                profile and runs first-run setup again. Apps, screen time, web
                settings and the parent PIN are kept.
            -->
            <Border Background="{StaticResource TintNeutralBrush}" Style="{StaticResource InfoPanelStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        FontFamily="{StaticResource SymbolFontFamily}"
                        FontSize="20"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Glyph="&#xE72C;"
                        VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="{loc:Str Key=Profile.RerunOnboarding}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{loc:Str Key=Profile.RerunBody}" />
                    </StackPanel>

                    <Button
                        x:Name="RerunOnboardingButton"
                        Grid.Column="2"
                        Content="{loc:Str Key=Profile.RerunOnboarding}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>


            <!--
                Om KidShell.

                Every line is derived: the version from the assembly, the
                edition from the readiness report, the security state from what
                KidShell can verify. A constant somebody has to remember to
                update is a constant that eventually lies.
            -->
            <Border Background="{StaticResource TintNeutralBrush}" Style="{StaticResource InfoPanelStyle}">
                <StackPanel Spacing="14">

                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{loc:Str Key=About.Title}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{loc:Str Key=About.Subtitle}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- A developer build says so loudly: its PIN is published. -->
                    <Border
                        x:Name="DevelopmentWarning"
                        Background="{StaticResource TintAmberBrush}"
                        CornerRadius="12"
                        Padding="14,11"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                FontFamily="{StaticResource SymbolFontFamily}"
                                FontSize="20"
                                Foreground="{StaticResource StatusWarningBrush}"
                                Glyph="&#xE7BA;"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{loc:Str Key=About.DevelopmentWarning}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="AboutFacts">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AboutFact">
                                <Grid Margin="0,0,0,12" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="{x:Bind Label}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{StaticResource BodyTextStyle}"
                                            Text="{x:Bind Value}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{x:Bind Detail}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind Detail, Converter={StaticResource StringToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
