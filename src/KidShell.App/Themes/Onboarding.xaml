<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        First-run setup.

        Setup is the first thing anyone sees of KidShell, so it gets its own
        scale of type and controls: bigger than Parent Mode, calmer than the
        child grid. Everything still comes from the shared tokens.
    -->

    <!-- ===================== Typography ===================== -->
    <Style x:Key="SetupHeadlineTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="46" />
    </Style>

    <Style x:Key="SetupBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        Quiet supporting text on a setup screen: hints, caveats, the paragraph
        that says what setup did NOT do. Smaller and softer than the body style,
        which is sized to sit under a headline.
    -->
    <Style x:Key="SetupCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SetupBodyTextStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.82" />
    </Style>

    <Style x:Key="SetupStepTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>

    <!-- ===================== The card setup sits on ===================== -->
    <Style x:Key="SetupPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#FAFFFFFF" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="44,36,44,32" />
        <Setter Property="Shadow" Value="{StaticResource OverlayShadow}" />
    </Style>

    <!-- ===================== Buttons ===================== -->
    <!--
        Setup buttons are large, so the app-wide pill radius would round them
        into ovals. A softer rectangle keeps them reading as buttons.
    -->
    <Style x:Key="SetupPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Padding" Value="34,13" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>

    <Style x:Key="SetupSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Padding" Value="28,13" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>

    <!-- ===================== Selectable tiles =====================
         A real Button underneath every choice, so pointer, touch, Tab, Enter
         and Space all work and the platform focus visual shows up. The chosen
         state is drawn by the item template, never by the template alone.
    -->
    <Style x:Key="SetupTileStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-5" />
        <Setter Property="FocusVisualPrimaryThickness" Value="3" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource FocusOuterBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource FocusInnerBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="LayoutRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.12" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.14" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Surface inside a tile. Selection is a thick brand ring plus a badge. -->
    <Style x:Key="SetupTileSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelStrongBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style x:Key="SetupTileSelectedSurfaceStyle" TargetType="Border" BasedOn="{StaticResource SetupTileSurfaceStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource BrandBlueLightBrush}" />
        <Setter Property="BorderThickness" Value="4" />
        <Setter Property="Background" Value="{StaticResource TintBlueBrush}" />
    </Style>

    <Style x:Key="SetupTileLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SetupAgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== Name entry ===================== -->
    <Style x:Key="SetupNameTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- ===================== Theme preview swatches ===================== -->
    <LinearGradientBrush x:Key="ThemeSwatchForest" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFA9D8F4" />
        <GradientStop Offset="0.55" Color="#FFCFE9FA" />
        <GradientStop Offset="0.56" Color="#FF76C77A" />
        <GradientStop Offset="1" Color="#FF59B463" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ThemeSwatchSpace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF141A3C" />
        <GradientStop Offset="0.55" Color="#FF2C2A6B" />
        <GradientStop Offset="0.56" Color="#FF3A3563" />
        <GradientStop Offset="1" Color="#FF2C2950" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ThemeSwatchOcean" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF63C1E8" />
        <GradientStop Offset="0.5" Color="#FFA8E0F2" />
        <GradientStop Offset="0.51" Color="#FF2FA3C9" />
        <GradientStop Offset="1" Color="#FF2E9FB5" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ThemeSwatchDino" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFF7B27A" />
        <GradientStop Offset="0.55" Color="#FFFBD3A6" />
        <GradientStop Offset="0.56" Color="#FF7DA254" />
        <GradientStop Offset="1" Color="#FF5F8742" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ThemeSwatchBright" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFA8D2" />
        <GradientStop Offset="0.5" Color="#FFFFD79B" />
        <GradientStop Offset="0.51" Color="#FF7FC8F0" />
        <GradientStop Offset="1" Color="#FFA88BEA" />
    </LinearGradientBrush>

</ResourceDictionary>
