<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Panels ===================== -->
    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
        <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--
            Translation is not settable from a Setter, so elevation is applied
            inline on the panels that need it (see ParentShellView).
        -->
        <Setter Property="Shadow" Value="{StaticResource PanelShadow}" />
    </Style>

    <Style x:Key="PanelStyleTight" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
        <Setter Property="Padding" Value="{StaticResource PanelPaddingTight}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>

    <!-- Tinted info panel: same geometry, no shadow, coloured ground. -->
    <Style x:Key="InfoPanelStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{StaticResource TintBlueBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    </Style>

    <!-- Round tinted badge that leads an info panel. -->
    <Style x:Key="PanelBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Background" Value="{StaticResource PanelStrongBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- ===================== Rows ===================== -->
    <Style x:Key="ListRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    </Style>

    <!-- ===================== Status chips ===================== -->
    <Style x:Key="StatusChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Background" Value="{StaticResource TintNeutralBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource SymbolFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== Toggle switch =====================
         KidShell overrides the stock WinUI toggle brushes rather than
         re-templating the control, so keyboard, narrator and touch behaviour
         stay exactly as the platform intends.
    -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource BrandBlueLightColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource BrandBlueColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource BrandBlueDeepColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FFE3E8ED" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#FFD8DEE5" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#FFCBD3DB" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FFC9D2DA" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFFFF" />

    <Style x:Key="AppToggleStyle" TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Width" Value="52" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- ===================== Dialogs =====================
         Overriding the stock ContentDialog brushes keeps the platform
         behaviour (focus, escape, light dismiss) while matching the KidShell
         surface language.
    -->
    <CornerRadius x:Key="OverlayCornerRadius">20</CornerRadius>
    <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#14163250" />
    <SolidColorBrush x:Key="ContentDialogForeground" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#1F163250" />
    <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#7F08203A" />
    <Thickness x:Key="ContentDialogPadding">26,22,26,22</Thickness>

    <!-- ===================== Inputs ===================== -->
    <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <Style x:Key="FormLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="2,0,0,6" />
    </Style>

</ResourceDictionary>
