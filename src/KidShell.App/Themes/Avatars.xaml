<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Avatar choices.

        Abstract, drawn in vector here, and therefore free of any third-party
        image licence. AvatarPresenter resolves "Avatar_<id>" from the
        ChildProfile.AvatarId value.
    -->

    <DataTemplate x:Key="Avatar_fox">
        <Canvas Width="100" Height="100">
            <Ellipse Width="100" Height="100" Fill="#FFF9A03F" />
            <Path Fill="#FFE07B2C" Data="M 22,30 L 30,10 L 44,24 Z" />
            <Path Fill="#FFE07B2C" Data="M 78,30 L 70,10 L 56,24 Z" />
            <Ellipse Canvas.Left="20" Canvas.Top="26" Width="60" Height="56" Fill="#FFFBB05A" />
            <Ellipse Canvas.Left="30" Canvas.Top="58" Width="40" Height="26" Fill="#FFFDF4E6" />
            <Ellipse Canvas.Left="34" Canvas.Top="44" Width="10" Height="12" Fill="#FF3B2A1E" />
            <Ellipse Canvas.Left="56" Canvas.Top="44" Width="10" Height="12" Fill="#FF3B2A1E" />
            <Ellipse Canvas.Left="45" Canvas.Top="62" Width="10" Height="8" Fill="#FF3B2A1E" />
        </Canvas>
    </DataTemplate>

    <DataTemplate x:Key="Avatar_owl">
        <Canvas Width="100" Height="100">
            <Ellipse Width="100" Height="100" Fill="#FF9D84E8" />
            <Path Fill="#FF7C63CC" Data="M 24,26 L 34,8 L 46,22 Z" />
            <Path Fill="#FF7C63CC" Data="M 76,26 L 66,8 L 54,22 Z" />
            <Ellipse Canvas.Left="16" Canvas.Top="24" Width="68" Height="62" Fill="#FFB49CF2" />
            <Ellipse Canvas.Left="24" Canvas.Top="38" Width="26" Height="26" Fill="#FFFDFBFF" />
            <Ellipse Canvas.Left="50" Canvas.Top="38" Width="26" Height="26" Fill="#FFFDFBFF" />
            <Ellipse Canvas.Left="32" Canvas.Top="46" Width="11" Height="11" Fill="#FF322347" />
            <Ellipse Canvas.Left="58" Canvas.Top="46" Width="11" Height="11" Fill="#FF322347" />
            <Path Fill="#FFF7C331" Data="M 50,62 L 56,72 L 44,72 Z" />
        </Canvas>
    </DataTemplate>

    <DataTemplate x:Key="Avatar_bear">
        <Canvas Width="100" Height="100">
            <Ellipse Width="100" Height="100" Fill="#FFB98157" />
            <Ellipse Canvas.Left="14" Canvas.Top="14" Width="26" Height="26" Fill="#FF9A6942" />
            <Ellipse Canvas.Left="60" Canvas.Top="14" Width="26" Height="26" Fill="#FF9A6942" />
            <Ellipse Canvas.Left="18" Canvas.Top="24" Width="64" Height="60" Fill="#FFCB9569" />
            <Ellipse Canvas.Left="34" Canvas.Top="56" Width="32" Height="24" Fill="#FFF3E3D0" />
            <Ellipse Canvas.Left="35" Canvas.Top="42" Width="10" Height="10" Fill="#FF3B2A1E" />
            <Ellipse Canvas.Left="55" Canvas.Top="42" Width="10" Height="10" Fill="#FF3B2A1E" />
            <Ellipse Canvas.Left="44" Canvas.Top="60" Width="12" Height="9" Fill="#FF3B2A1E" />
        </Canvas>
    </DataTemplate>

    <DataTemplate x:Key="Avatar_panda">
        <Canvas Width="100" Height="100">
            <Ellipse Width="100" Height="100" Fill="#FF8FB8D8" />
            <Ellipse Canvas.Left="14" Canvas.Top="16" Width="24" Height="24" Fill="#FF2D3540" />
            <Ellipse Canvas.Left="62" Canvas.Top="16" Width="24" Height="24" Fill="#FF2D3540" />
            <Ellipse Canvas.Left="18" Canvas.Top="24" Width="64" Height="60" Fill="#FFFAFBFC" />
            <Ellipse Canvas.Left="30" Canvas.Top="42" Width="18" Height="20" Fill="#FF2D3540" />
            <Ellipse Canvas.Left="52" Canvas.Top="42" Width="18" Height="20" Fill="#FF2D3540" />
            <Ellipse Canvas.Left="35" Canvas.Top="48" Width="8" Height="8" Fill="#FFFAFBFC" />
            <Ellipse Canvas.Left="57" Canvas.Top="48" Width="8" Height="8" Fill="#FFFAFBFC" />
            <Ellipse Canvas.Left="44" Canvas.Top="64" Width="12" Height="8" Fill="#FF2D3540" />
        </Canvas>
    </DataTemplate>

    <DataTemplate x:Key="Avatar_rocket">
        <Canvas Width="100" Height="100">
            <Ellipse Width="100" Height="100" Fill="#FF3D9BE9" />
            <Path Fill="#FFE8574F" Data="M 32,60 L 22,76 L 38,72 Z" />
            <Path Fill="#FFE8574F" Data="M 68,60 L 78,76 L 62,72 Z" />
            <Path Fill="#FFFAFBFC" Data="M 50,12 C 64,26 68,46 64,74 L 36,74 C 32,46 36,26 50,12 Z" />
            <Ellipse Canvas.Left="41" Canvas.Top="32" Width="18" Height="18" Fill="#FF3D9BE9" />
            <Ellipse Canvas.Left="44" Canvas.Top="35" Width="8" Height="8" Fill="#FFCFE8FA" />
            <Path Fill="#FFF7C331" Data="M 42,76 L 58,76 L 50,94 Z" />
        </Canvas>
    </DataTemplate>

    <DataTemplate x:Key="Avatar_blossom">
        <Canvas Width="100" Height="100">
            <Ellipse Width="100" Height="100" Fill="#FFF2A0C0" />
            <Ellipse Canvas.Left="40" Canvas.Top="12" Width="20" Height="28" Fill="#FFFDF0F5" />
            <Ellipse Canvas.Left="62" Canvas.Top="32" Width="28" Height="20" Fill="#FFFDF0F5" />
            <Ellipse Canvas.Left="54" Canvas.Top="58" Width="22" Height="26" Fill="#FFFDF0F5" />
            <Ellipse Canvas.Left="24" Canvas.Top="58" Width="22" Height="26" Fill="#FFFDF0F5" />
            <Ellipse Canvas.Left="10" Canvas.Top="32" Width="28" Height="20" Fill="#FFFDF0F5" />
            <Ellipse Canvas.Left="36" Canvas.Top="36" Width="28" Height="28" Fill="#FFF7C331" />
        </Canvas>
    </DataTemplate>

</ResourceDictionary>
