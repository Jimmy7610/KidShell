<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        KidShell app iconography.

        Every icon is drawn here as vector shapes on a 100x100 canvas, so it
        stays crisp at 100%, 125%, 150% and on a 2560x1440 panel, and so the
        repository contains no third-party artwork. AppIconPresenter looks a
        template up by the "Icon" key stored on each KidAppDefinition.
    -->

    <!-- ===================== Rita / Paint ===================== -->
    <DataTemplate x:Key="Icon_paint">
        <Canvas Width="100" Height="100">
            <Ellipse
                Canvas.Left="8" Canvas.Top="24"
                Width="66" Height="58"
                Fill="#FFFDF7EE" Stroke="#FFE4D6C2" StrokeThickness="2" />
            <Ellipse
                Canvas.Left="44" Canvas.Top="56"
                Width="16" Height="14"
                Fill="#FFE8DAC6" />
            <Ellipse Canvas.Left="18" Canvas.Top="36" Width="11" Height="11" Fill="#FFE4572E" />
            <Ellipse Canvas.Left="34" Canvas.Top="30" Width="11" Height="11" Fill="#FFF7C331" />
            <Ellipse Canvas.Left="50" Canvas.Top="36" Width="11" Height="11" Fill="#FF3D9BE9" />
            <Ellipse Canvas.Left="18" Canvas.Top="56" Width="11" Height="11" Fill="#FF5CB85C" />

            <Path Fill="#FF2F6FB0" Data="M 62,72 L 88,34 L 96,40 L 70,78 Z" />
            <Path Fill="#FFE6E9ED" Data="M 62,72 L 70,78 L 60,84 Z" />
            <Path Fill="#FFC2452D" Data="M 60,84 L 55,88 L 57,80 Z" />
        </Canvas>
    </DataTemplate>

    <!-- ===================== Spel / Games ===================== -->
    <DataTemplate x:Key="Icon_games">
        <Canvas Width="100" Height="100">
            <Rectangle
                Canvas.Left="8" Canvas.Top="32"
                Width="84" Height="38" RadiusX="19" RadiusY="19"
                Fill="#FFFDFDFD" Stroke="#FFD6DEE7" StrokeThickness="2" />
            <Path Fill="#FFFDFDFD" Stroke="#FFD6DEE7" StrokeThickness="2" Data="M 22,66 C 16,78 26,84 32,76 L 38,68 Z" />
            <Path Fill="#FFFDFDFD" Stroke="#FFD6DEE7" StrokeThickness="2" Data="M 78,66 C 84,78 74,84 68,76 L 62,68 Z" />

            <Rectangle Canvas.Left="26" Canvas.Top="40" Width="8" Height="22" RadiusX="3" RadiusY="3" Fill="#FF46536B" />
            <Rectangle Canvas.Left="19" Canvas.Top="47" Width="22" Height="8" RadiusX="3" RadiusY="3" Fill="#FF46536B" />

            <Ellipse Canvas.Left="62" Canvas.Top="38" Width="10" Height="10" Fill="#FFE4572E" />
            <Ellipse Canvas.Left="72" Canvas.Top="46" Width="10" Height="10" Fill="#FFF7C331" />
            <Ellipse Canvas.Left="62" Canvas.Top="54" Width="10" Height="10" Fill="#FF5CB85C" />
            <Ellipse Canvas.Left="52" Canvas.Top="46" Width="10" Height="10" Fill="#FF3D9BE9" />
        </Canvas>
    </DataTemplate>

    <!-- ===================== Lära / Learn ===================== -->
    <DataTemplate x:Key="Icon_learn">
        <Canvas Width="100" Height="100">
            <Ellipse Canvas.Left="24" Canvas.Top="14" Width="52" Height="52" Fill="#66FFF3C4" />
            <Ellipse
                Canvas.Left="30" Canvas.Top="20"
                Width="40" Height="40"
                Fill="#FFFFE47D" Stroke="#FFEFAE12" StrokeThickness="3" />
            <Ellipse Canvas.Left="37" Canvas.Top="27" Width="14" Height="12" Fill="#99FFFFFF" />
            <Rectangle Canvas.Left="42" Canvas.Top="60" Width="16" Height="9" RadiusX="3" RadiusY="3" Fill="#FFD7DCE3" />
            <Rectangle Canvas.Left="43" Canvas.Top="71" Width="14" Height="7" RadiusX="3" RadiusY="3" Fill="#FFB6BDC6" />
            <Rectangle Canvas.Left="46" Canvas.Top="80" Width="8" Height="5" RadiusX="2" RadiusY="2" Fill="#FF98A0AA" />

            <Path Stroke="#FFF7C331" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 50,4 L 50,12" />
            <Path Stroke="#FFF7C331" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 16,18 L 22,24" />
            <Path Stroke="#FFF7C331" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 84,18 L 78,24" />
            <Path Stroke="#FFF7C331" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 8,44 L 16,44" />
            <Path Stroke="#FFF7C331" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 92,44 L 84,44" />
        </Canvas>
    </DataTemplate>

    <!-- ===================== Miniräknare / Calculator ===================== -->
    <DataTemplate x:Key="Icon_calculator">
        <Canvas Width="100" Height="100">
            <Rectangle
                Canvas.Left="24" Canvas.Top="10"
                Width="52" Height="80" RadiusX="11" RadiusY="11"
                Fill="#FF2F6FB0" />
            <Rectangle
                Canvas.Left="31" Canvas.Top="18"
                Width="38" Height="16" RadiusX="4" RadiusY="4"
                Fill="#FFDCEBF8" />
            <Rectangle Canvas.Left="31" Canvas.Top="41" Width="11" Height="10" RadiusX="3" RadiusY="3" Fill="#FFFFFFFF" />
            <Rectangle Canvas.Left="45" Canvas.Top="41" Width="11" Height="10" RadiusX="3" RadiusY="3" Fill="#FFFFFFFF" />
            <Rectangle Canvas.Left="59" Canvas.Top="41" Width="11" Height="10" RadiusX="3" RadiusY="3" Fill="#FFF5A623" />
            <Rectangle Canvas.Left="31" Canvas.Top="55" Width="11" Height="10" RadiusX="3" RadiusY="3" Fill="#FFFFFFFF" />
            <Rectangle Canvas.Left="45" Canvas.Top="55" Width="11" Height="10" RadiusX="3" RadiusY="3" Fill="#FFFFFFFF" />
            <Rectangle Canvas.Left="59" Canvas.Top="55" Width="11" Height="24" RadiusX="3" RadiusY="3" Fill="#FFF5A623" />
            <Rectangle Canvas.Left="31" Canvas.Top="69" Width="11" Height="10" RadiusX="3" RadiusY="3" Fill="#FFFFFFFF" />
            <Rectangle Canvas.Left="45" Canvas.Top="69" Width="11" Height="10" RadiusX="3" RadiusY="3" Fill="#FFFFFFFF" />
        </Canvas>
    </DataTemplate>

    <!-- ===================== Musik / Music ===================== -->
    <DataTemplate x:Key="Icon_music">
        <Canvas Width="100" Height="100">
            <Path Fill="#FFF6B24A" Data="M 42,24 L 82,16 L 82,30 L 42,38 Z" />
            <Rectangle Canvas.Left="42" Canvas.Top="24" Width="6" Height="46" Fill="#FFF6B24A" />
            <Rectangle Canvas.Left="76" Canvas.Top="16" Width="6" Height="46" Fill="#FFF6B24A" />
            <Ellipse Canvas.Left="24" Canvas.Top="60" Width="24" Height="20" Fill="#FFF6B24A" />
            <Ellipse Canvas.Left="58" Canvas.Top="52" Width="24" Height="20" Fill="#FFF6B24A" />
            <Ellipse Canvas.Left="29" Canvas.Top="65" Width="9" Height="7" Fill="#33FFFFFF" />
            <Ellipse Canvas.Left="63" Canvas.Top="57" Width="9" Height="7" Fill="#33FFFFFF" />
        </Canvas>
    </DataTemplate>

    <!-- ===================== Läsa / Reading ===================== -->
    <DataTemplate x:Key="Icon_reading">
        <Canvas Width="100" Height="100">
            <Rectangle
                Canvas.Left="10" Canvas.Top="24"
                Width="80" Height="54" RadiusX="7" RadiusY="7"
                Fill="#FFE0574F" />
            <Path Fill="#FFFBF6EC" Data="M 15,30 L 48,39 L 48,73 L 15,64 Z" />
            <Path Fill="#FFFFFDF7" Data="M 85,30 L 52,39 L 52,73 L 85,64 Z" />
            <Rectangle Canvas.Left="47" Canvas.Top="37" Width="6" Height="37" Fill="#FFC9483F" />
            <Rectangle Canvas.Left="21" Canvas.Top="44" Width="20" Height="3" Fill="#FFD9D2C6" />
            <Rectangle Canvas.Left="21" Canvas.Top="52" Width="20" Height="3" Fill="#FFD9D2C6" />
            <Rectangle Canvas.Left="21" Canvas.Top="60" Width="14" Height="3" Fill="#FFD9D2C6" />
            <Rectangle Canvas.Left="59" Canvas.Top="44" Width="20" Height="3" Fill="#FFD9D2C6" />
            <Rectangle Canvas.Left="59" Canvas.Top="52" Width="20" Height="3" Fill="#FFD9D2C6" />
            <Rectangle Canvas.Left="59" Canvas.Top="60" Width="14" Height="3" Fill="#FFD9D2C6" />
        </Canvas>
    </DataTemplate>

    <!-- ===================== Film / Video ===================== -->
    <DataTemplate x:Key="Icon_video">
        <Canvas Width="100" Height="100">
            <Rectangle
                Canvas.Left="12" Canvas.Top="42"
                Width="76" Height="42" RadiusX="7" RadiusY="7"
                Fill="#FF2B3B54" />
            <Rectangle
                Canvas.Left="12" Canvas.Top="24"
                Width="76" Height="18" RadiusX="4" RadiusY="4"
                Fill="#FF1E2B3F" />
            <Path Fill="#FFFFFFFF" Data="M 20,24 L 30,24 L 22,42 L 12,42 Z" />
            <Path Fill="#FFFFFFFF" Data="M 42,24 L 52,24 L 44,42 L 34,42 Z" />
            <Path Fill="#FFFFFFFF" Data="M 64,24 L 74,24 L 66,42 L 56,42 Z" />
            <Path Fill="#FFFFFFFF" Data="M 42,52 L 66,63 L 42,74 Z" />
        </Canvas>
    </DataTemplate>

    <!-- ===================== Minecraft / Blocks ===================== -->
    <DataTemplate x:Key="Icon_blocks">
        <Canvas Width="100" Height="100">
            <Path Fill="#FF7CC144" Data="M 50,14 L 86,32 L 50,50 L 14,32 Z" />
            <Path Fill="#FF6AAE38" Data="M 14,32 L 50,50 L 50,60 L 14,42 Z" />
            <Path Fill="#FF5E9B34" Data="M 86,32 L 86,42 L 50,60 L 50,50 Z" />
            <Path Fill="#FF8A5E3B" Data="M 14,42 L 50,60 L 50,88 L 14,70 Z" />
            <Path Fill="#FF6F4A2E" Data="M 86,42 L 86,70 L 50,88 L 50,60 Z" />
            <Path Fill="#FF96D25C" Data="M 32,23 L 44,29 L 38,32 L 26,26 Z" />
            <Path Fill="#FF9C6B44" Data="M 22,50 L 32,55 L 32,64 L 22,59 Z" />
            <Path Fill="#FF7E5434" Data="M 60,66 L 72,60 L 72,70 L 60,76 Z" />
        </Canvas>
    </DataTemplate>

    <!-- ===================== Webbläsare / Browser ===================== -->
    <DataTemplate x:Key="Icon_browser">
        <Canvas Width="100" Height="100">
            <Ellipse Canvas.Left="16" Canvas.Top="16" Width="68" Height="68" Fill="#FF3D9BE9" />
            <Ellipse
                Canvas.Left="36" Canvas.Top="16"
                Width="28" Height="68"
                Stroke="#FFFFFFFF" StrokeThickness="3" />
            <Path Stroke="#FFFFFFFF" StrokeThickness="3" Data="M 18,50 L 82,50" />
            <Path Stroke="#FFFFFFFF" StrokeThickness="3" Data="M 23,34 L 77,34" />
            <Path Stroke="#FFFFFFFF" StrokeThickness="3" Data="M 23,66 L 77,66" />
            <Ellipse
                Canvas.Left="16" Canvas.Top="16"
                Width="68" Height="68"
                Stroke="#FF2176C9" StrokeThickness="3" />
        </Canvas>
    </DataTemplate>

    <!-- ===================== Fallback ===================== -->
    <DataTemplate x:Key="Icon_generic">
        <Canvas Width="100" Height="100">
            <Rectangle
                Canvas.Left="18" Canvas.Top="18"
                Width="64" Height="64" RadiusX="16" RadiusY="16"
                Fill="#FFFFFFFF" Opacity="0.92" />
            <Path
                Fill="#FFF7C331"
                Data="M 50,30 L 56,44 L 71,45 L 59,54 L 63,69 L 50,60 L 37,69 L 41,54 L 29,45 L 44,44 Z" />
        </Canvas>
    </DataTemplate>

</ResourceDictionary>
