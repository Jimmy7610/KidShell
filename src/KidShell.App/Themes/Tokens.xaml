<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        KidShell design tokens.

        Every colour, radius, shadow and spacing step used anywhere in the app
        is defined once here. Pages and controls reference these keys; they
        never hard-code a hex value.
    -->

    <!-- ===================== Brand ===================== -->
    <Color x:Key="BrandBlueColor">#FF1668C1</Color>
    <Color x:Key="BrandBlueLightColor">#FF3898EC</Color>
    <Color x:Key="BrandBlueDeepColor">#FF0E4F97</Color>
    <Color x:Key="BrandSparkColor">#FFFBCB3A</Color>

    <SolidColorBrush x:Key="BrandBlueBrush" Color="{StaticResource BrandBlueColor}" />
    <SolidColorBrush x:Key="BrandBlueLightBrush" Color="{StaticResource BrandBlueLightColor}" />
    <SolidColorBrush x:Key="BrandSparkBrush" Color="{StaticResource BrandSparkColor}" />

    <LinearGradientBrush x:Key="BrandWordmarkBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource BrandBlueLightColor}" />
        <GradientStop Offset="1" Color="{StaticResource BrandBlueDeepColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryActionBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF3C9BEE" />
        <GradientStop Offset="1" Color="#FF1A6FC6" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryActionHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF52A9F2" />
        <GradientStop Offset="1" Color="#FF2A80D6" />
    </LinearGradientBrush>

    <!-- ===================== Text ===================== -->
    <Color x:Key="TextPrimaryColor">#FF16324F</Color>
    <Color x:Key="TextSecondaryColor">#FF5D7389</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="TextOnAccentSoftBrush" Color="#E6FFFFFF" />

    <!-- ===================== Surfaces ===================== -->
    <SolidColorBrush x:Key="PanelBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="PanelSubtleBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="PanelStrongBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#14163250" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#0F1668C1" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#9908203A" />

    <!-- Tinted info panels used across Parent Mode -->
    <SolidColorBrush x:Key="TintBlueBrush" Color="#FFEAF4FE" />
    <SolidColorBrush x:Key="TintGreenBrush" Color="#FFEAF8EF" />
    <SolidColorBrush x:Key="TintAmberBrush" Color="#FFFEF6E3" />
    <SolidColorBrush x:Key="TintRoseBrush" Color="#FFFDEDEF" />
    <SolidColorBrush x:Key="TintNeutralBrush" Color="#FFF2F5F8" />

    <!-- ===================== Status ===================== -->
    <Color x:Key="StatusOkColor">#FF1F9D55</Color>
    <Color x:Key="StatusWarningColor">#FFC98407</Color>
    <Color x:Key="StatusInactiveColor">#FF7C8B99</Color>
    <Color x:Key="StatusAlertColor">#FFD94F4F</Color>

    <SolidColorBrush x:Key="StatusOkBrush" Color="{StaticResource StatusOkColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusInactiveBrush" Color="{StaticResource StatusInactiveColor}" />
    <SolidColorBrush x:Key="StatusAlertBrush" Color="{StaticResource StatusAlertColor}" />

    <!-- ===================== Scene (illustrated background) ===================== -->
    <Color x:Key="SkyTopColor">#FFB6DEF6</Color>
    <Color x:Key="SkyBottomColor">#FFEAF6FD</Color>
    <SolidColorBrush x:Key="CloudBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="SunCoreBrush" Color="#FFFCD65B" />
    <SolidColorBrush x:Key="SunGlowBrush" Color="#3DFBCB3A" />
    <SolidColorBrush x:Key="HillFarBrush" Color="#FF9FD7A0" />
    <SolidColorBrush x:Key="HillMidBrush" Color="#FF76C77A" />
    <SolidColorBrush x:Key="HillNearBrush" Color="#FF59B463" />
    <SolidColorBrush x:Key="MountainBrush" Color="#FF8FB2D1" />
    <SolidColorBrush x:Key="MountainSnowBrush" Color="#FFE8F1F8" />
    <SolidColorBrush x:Key="LakeBrush" Color="#FF78C0E8" />
    <SolidColorBrush x:Key="TreeDarkBrush" Color="#FF3F9A54" />
    <SolidColorBrush x:Key="TreeLightBrush" Color="#FF63B96C" />
    <SolidColorBrush x:Key="TrunkBrush" Color="#FF8A6046" />
    <SolidColorBrush x:Key="FoamBrush" Color="#FFF3FAFF" />

    <!-- ===================== Card accents =====================
         One gradient + one solid per AccentStyle in KidShell.Core.
    -->
    <LinearGradientBrush x:Key="AccentRoseBrush" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Offset="0" Color="#FFF79CC2" />
        <GradientStop Offset="1" Color="#FFEE6FA6" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGrassBrush" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Offset="0" Color="#FF7FD37F" />
        <GradientStop Offset="1" Color="#FF52B95C" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentSunBrush" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Offset="0" Color="#FFFCD65B" />
        <GradientStop Offset="1" Color="#FFF3B81B" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentSkyBrush" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Offset="0" Color="#FFB2D8F7" />
        <GradientStop Offset="1" Color="#FF7BB8EC" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGrapeBrush" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Offset="0" Color="#FFC2ABF5" />
        <GradientStop Offset="1" Color="#FF9D84E8" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentCoralBrush" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Offset="0" Color="#FFF78A80" />
        <GradientStop Offset="1" Color="#FFE9615A" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentTealBrush" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Offset="0" Color="#FF6ED3C3" />
        <GradientStop Offset="1" Color="#FF3FB6A6" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentLeafBrush" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Offset="0" Color="#FF9CDC77" />
        <GradientStop Offset="1" Color="#FF74C551" />
    </LinearGradientBrush>

    <!-- ===================== Radii ===================== -->
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">14</CornerRadius>
    <CornerRadius x:Key="RadiusLg">20</CornerRadius>
    <CornerRadius x:Key="RadiusXl">26</CornerRadius>
    <CornerRadius x:Key="RadiusCard">30</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ===================== Spacing ===================== -->
    <x:Double x:Key="Space2xs">4</x:Double>
    <x:Double x:Key="SpaceXs">8</x:Double>
    <x:Double x:Key="SpaceSm">12</x:Double>
    <x:Double x:Key="SpaceMd">18</x:Double>
    <x:Double x:Key="SpaceLg">26</x:Double>
    <x:Double x:Key="SpaceXl">36</x:Double>
    <x:Double x:Key="Space2xl">52</x:Double>

    <Thickness x:Key="PanelPadding">24</Thickness>
    <Thickness x:Key="PanelPaddingTight">18</Thickness>
    <Thickness x:Key="StagePadding">40,22,40,20</Thickness>

    <!-- ===================== Elevation ===================== -->
    <ThemeShadow x:Key="CardShadow" />
    <ThemeShadow x:Key="PanelShadow" />
    <ThemeShadow x:Key="OverlayShadow" />

    <x:Double x:Key="CardRestDepth">14</x:Double>
    <x:Double x:Key="CardHoverDepth">34</x:Double>
    <x:Double x:Key="PanelDepth">22</x:Double>
    <x:Double x:Key="OverlayDepth">64</x:Double>

    <!-- ===================== Focus ===================== -->
    <SolidColorBrush x:Key="FocusOuterBrush" Color="#FF0E4F97" />
    <SolidColorBrush x:Key="FocusInnerBrush" Color="#FFFFFFFF" />
    <x:Double x:Key="FocusOuterThickness">3</x:Double>

</ResourceDictionary>
