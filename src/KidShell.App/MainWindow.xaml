<Window
    x:Class="KidShell.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:KidShell.App.Views"
    mc:Ignorable="d">

    <!--
        One window, three layers: the illustrated scene, the active mode, and
        the PIN gate on top. Swapping modes is a visibility change rather than
        a navigation, so Child Mode never has to be rebuilt from scratch.
    -->
    <Grid x:Name="RootLayer" RequestedTheme="Light">

        <views:SceneBackground x:Name="Scene" />

        <!-- Drag strip for the extended title bar. Nothing interactive lives here. -->
        <Grid
            x:Name="AppTitleBar"
            Height="32"
            VerticalAlignment="Top"
            Background="Transparent" />

        <views:ChildHomeView x:Name="ChildView" />

        <views:ParentShellView x:Name="ParentView" Visibility="Collapsed" />

        <views:PinOverlayView x:Name="PinOverlay" Visibility="Collapsed" />

    </Grid>
</Window>
